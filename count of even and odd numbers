class Node:
    def __init__(self, data):
        self.data = data
        self.next = None
n1 = Node(10)
n2 = Node(20)
n3 = Node(30)
n4 = Node(40)
n5 = Node(99)

# Connect nodes
n1.next = n2
n2.next = n3
n3.next = n4
n4.next = n5

head = n1
temp = head
even = 0
odd = 0
while temp is not None:
    if temp.data % 2 == 0:
        even += 1
    else:
        odd += 1
    temp = temp.next
print("even number:", even)
print("odd number:", odd)
